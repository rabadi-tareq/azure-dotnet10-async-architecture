<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <UserSecretsId>dotnet-AsyncTickets.TicketRenderer-c86beace-5b54-480d-811f-83548196f47c</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
	<None Remove="Fonts\**\*.ttf" />
    <EmbeddedResource Include="Fonts\**\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for built-in Azure SDK OpenTelemetry tracing of Service Bus activity which is still experimental.
         https://learn.microsoft.com/azure/service-bus-messaging/service-bus-end-to-end-tracing#tracking-with-opentelemetry -->
    <RuntimeHostConfigurationOption Include="Azure.Experimental.EnableActivitySource" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.AzureServiceBus" Version="7.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.AzureStorage" Version="7.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.2" />
    <PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" Version="8.6.1" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="[1.19.6-Preview.1, 1.19.6]" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.6" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsyncTickets.Models\AsyncTickets.Models.csproj" />
    <ProjectReference Include="..\AsyncTickets.Messaging\AsyncTickets.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--Make internal types visible to test project and dynamic proxy generator for test purposes-->
    <InternalsVisibleTo Include="AsyncTickets.TicketRenderer.TestHelpers" />    
    <InternalsVisibleTo Include="AsyncTickets.TicketRenderer.Tests" />
    <InternalsVisibleTo Include="AsyncTickets.TicketRenderer.IntegrationTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
  </ItemGroup>
</Project>
