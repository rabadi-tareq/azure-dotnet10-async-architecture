<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>132c573d-ea30-413d-9176-5f0fe269d568</UserSecretsId>
	</PropertyGroup>
	<PropertyGroup>
	</PropertyGroup>

  <ItemGroup>
    <!-- Required for built-in Azure SDK OpenTelemetry tracing of Service Bus activity which is still experimental.
         https://learn.microsoft.com/azure/service-bus-messaging/service-bus-end-to-end-tracing#tracking-with-opentelemetry -->
    <RuntimeHostConfigurationOption Include="Azure.Experimental.EnableActivitySource" Value="true" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
		<PackageReference Include="Azure.Search.Documents" Version="11.4.0-beta.5" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.30.2" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
		<PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" Version="8.6.1" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.15" />
		<PackageReference Include="Microsoft.Azure.StackExchangeRedis" Version="3.3.1" />
		<PackageReference Include="Microsoft.FeatureManagement" Version="3.1.1" />
		<PackageReference Include="Microsoft.Identity.Web" Version="2.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.0.0-rc9.14" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AsyncTickets.Models\AsyncTickets.Models.csproj" />
		<ProjectReference Include="..\AsyncTickets.Messaging\AsyncTickets.Messaging.csproj" />
	</ItemGroup>

  <ItemGroup>
    <!--Make internal types visible to test project and dynamic proxy generator for test purposes-->
    <InternalsVisibleTo Include="AsyncTickets.Web.CallCenter.Api.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
  </ItemGroup>
</Project>
